# Mission Control — environment. Copy to `.env` and fill in only what you need.
# NEVER commit a real .env (it's gitignored). The dashboard/backend hold NO secrets;
# secrets live here in the environment only.

# --- Backend (all optional; sensible defaults shown) ---
# MC_HOST=127.0.0.1
# MC_PORT=8754
# MC_STATE_DIR=./server/state

# Point at your Obsidian vault (default: ~/Desktop/ai_2nd_Brain)
# VAULT_DIR=/Users/you/Path/To/Your/Vault

# Max notes shipped to the Memory Galaxy canvas (total still counted)
# MC_GALAXY_MAX=220

# --- Optional live integrations (currently show "Sample data · not connected") ---
# Wiring these flips the matching connector to LIVE. Implement the fetch in the
# backend, then read the token from these vars — do not paste tokens into the UI.

# Google (Gmail / Calendar / Drive) — OAuth 2.0 access token or refresh flow
# GOOGLE_OAUTH_TOKEN=

# Notion integration token
# NOTION_TOKEN=

# Claude API (if you later let the backend call a model directly)
# ANTHROPIC_API_KEY=

# AI spend / billing (OpenRouter or Anthropic admin) for the Usage page
# OPENROUTER_API_KEY=
# ANTHROPIC_ADMIN_KEY=
